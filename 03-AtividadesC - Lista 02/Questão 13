#include <stdio.h>

int main() {

    float limite, velocidade, percentual;

    printf("Digite a velocidade maxima da via: ");
    scanf("%f", &limite);

    printf("Digite a velocidade do veiculo: ");
    scanf("%f", &velocidade);

    if (velocidade <= limite) {

        printf("\nNao houve infracao.\n");

    } else {

        percentual = ((velocidade - limite) / limite) * 100;

        if (percentual <= 20) {
            printf("\nInfracao media.\n");
        } 
        else if (percentual <= 50) {
            printf("\nInfracao grave.\n");
        } 
        else {
            printf("\nInfracao gravissima.\n");
        }

        if (velocidade > 120) {
            printf("Alerta: velocidade extremamente elevada!\n");
        }

        printf("Limite: %.2f km/h\n", limite);
        printf("Velocidade: %.2f km/h\n", velocidade);
        printf("Percentual excedido: %.2f%%\n", percentual);
    }

    return 0;
}
